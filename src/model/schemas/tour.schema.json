{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustain.dev/schemas/tour-draft.schema.json",
  "title": "Sustain tour draft (SKL-02)",
  "type": "object",
  "additionalProperties": false,
  "required": ["stops"],
  "properties": {
    "stops": {
      "type": "array",
      "minItems": 4,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "title", "explanation", "question", "answer", "citation"],
        "properties": {
          "component": { "type": "string", "minLength": 1, "maxLength": 200 },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 400 },
          "question": { "type": "string", "minLength": 1, "maxLength": 300 },
          "answer": { "type": "string", "minLength": 1, "maxLength": 400 },
          "citation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "line"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 240 },
              "line": { "type": "integer", "minimum": 1 },
              "end_line": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
