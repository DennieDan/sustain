{
  "name": "sustain",
  "displayName": "Sustain",
  "description": "View a repository's architecture as an Archify diagram and open the code behind each node.",
  "version": "0.2.0",
  "publisher": "sustain",
  "private": true,
  "engines": {
    "vscode": "^1.126.0",
    "node": ">=18"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Sustain launches coding agents and runs git in the opened folder."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Sustain",
      "properties": {
        "sustain.skillScope": {
          "type": "string",
          "enum": [
            "user",
            "project"
          ],
          "enumDescriptions": [
            "Install the skills in your home folder (~/.claude/skills, ~/.agents/skills). Nothing is added to the repository.",
            "Install the skills in the repository (.claude/skills, .agents/skills)."
          ],
          "default": "user",
          "description": "Where Sustain installs its agent skills."
        },
        "sustain.runMode": {
          "type": "string",
          "enum": [
            "sidebar",
            "terminal"
          ],
          "enumDescriptions": [
            "Run the agent headless and stream its progress into the Sustain sidebar.",
            "Run the agent in a terminal, as you would yourself."
          ],
          "default": "sidebar",
          "description": "Where Generate runs the agent."
        }
      }
    },
    "commands": [
      {
        "command": "sustain.installSkills",
        "title": "Install Agent Skills",
        "category": "Sustain"
      },
      {
        "command": "sustain.generateArchitecture",
        "title": "Generate Architecture",
        "category": "Sustain"
      },
      {
        "command": "sustain.openArchitecture",
        "title": "Open Architecture",
        "category": "Sustain"
      },
      {
        "command": "sustain.openArchitectureFile",
        "title": "Open Architecture File…",
        "category": "Sustain"
      },
      {
        "command": "sustain.startLearning",
        "title": "Start Learning Session",
        "category": "Sustain"
      },
      {
        "command": "sustain.checkSetup",
        "title": "Check Setup",
        "category": "Sustain",
        "icon": "$(checklist)"
      },
      {
        "command": "sustain.refreshHome",
        "title": "Refresh",
        "category": "Sustain",
        "icon": "$(refresh)"
      },
      {
        "command": "sustain.cancelRun",
        "title": "Cancel Run",
        "category": "Sustain",
        "icon": "$(debug-stop)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sustain",
          "title": "Sustain",
          "icon": "media/sustain.svg"
        }
      ]
    },
    "views": {
      "sustain": [
        {
          "type": "webview",
          "id": "sustain.home",
          "name": "Sustain"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sustain.refreshHome",
          "when": "view == sustain.home",
          "group": "navigation@1"
        },
        {
          "command": "sustain.checkSetup",
          "when": "view == sustain.home",
          "group": "navigation@2"
        },
        {
          "command": "sustain.cancelRun",
          "when": "view == sustain.home && sustain.running",
          "group": "navigation@0"
        },
        {
          "command": "sustain.openArchitectureFile",
          "when": "view == sustain.home",
          "group": "more@1"
        },
        {
          "command": "sustain.installSkills",
          "when": "view == sustain.home",
          "group": "more@2"
        }
      ],
      "commandPalette": [
        {
          "command": "sustain.cancelRun",
          "when": "sustain.running"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:docs": "node scripts/check-docs.mjs",
    "notices": "node scripts/notices.mjs --write",
    "check:notices": "node scripts/notices.mjs --check",
    "check": "npm run typecheck && npm run test && npm run check:docs && npm run build && npm run check:notices",
    "test:e2e": "npm run build && node esbuild.mjs --e2e && node out/e2e/runTest.js",
    "vscode:prepublish": "node esbuild.mjs",
    "package": "vsce package --no-dependencies --skip-license --allow-missing-repository"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "elkjs": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "1.125.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.6",
    "mocha": "12.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
