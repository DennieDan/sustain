{
  "name": "sustain",
  "displayName": "Sustain",
  "description": "View a repository's architecture as an Archify diagram and open the code behind each node.",
  "icon": "media/icon.png",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/xplus2g4/sustain.git"
  },
  "homepage": "https://github.com/xplus2g4/sustain#readme",
  "bugs": {
    "url": "https://github.com/xplus2g4/sustain/issues"
  },
  "keywords": [
    "architecture",
    "diagram",
    "archify",
    "code map",
    "documentation",
    "claude code",
    "codex"
  ],
  "categories": [
    "Visualization",
    "AI",
    "Education"
  ],
  "version": "0.2.0",
  "publisher": "sustain",
  "private": true,
  "engines": {
    "vscode": "^1.126.0",
    "node": ">=18"
  },
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Sustain launches coding agents and runs git in the opened folder."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Sustain",
      "properties": {
        "sustain.skillScope": {
          "type": "string",
          "enum": [
            "user",
            "project"
          ],
          "enumDescriptions": [
            "Install the skills in your home folder (~/.claude/skills, ~/.agents/skills). Nothing is added to the repository.",
            "Install the skills in the repository (.claude/skills, .agents/skills)."
          ],
          "default": "user",
          "description": "Where Sustain installs its agent skills."
        },
        "sustain.runMode": {
          "type": "string",
          "enum": [
            "sidebar",
            "terminal"
          ],
          "enumDescriptions": [
            "Run the agent headless and stream its progress into the Sustain sidebar.",
            "Run the agent in a terminal, as you would yourself."
          ],
          "default": "sidebar",
          "description": "Where Generate runs the agent."
        },
        "sustain.confirmAboveTokens": {
          "type": "number",
          "default": 300000,
          "minimum": 0,
          "description": "Runs whose estimate reaches above this many tokens need a second click before they start."
        }
      }
    },
    "commands": [
      {
        "command": "sustain.installSkills",
        "title": "Install Agent Skills",
        "category": "Sustain"
      },
      {
        "command": "sustain.generateArchitecture",
        "title": "Generate Architecture",
        "category": "Sustain"
      },
      {
        "command": "sustain.openArchitecture",
        "title": "Open Architecture",
        "category": "Sustain"
      },
      {
        "command": "sustain.openArchitectureFile",
        "title": "Open Architecture File…",
        "category": "Sustain"
      },
      {
        "command": "sustain.startLearning",
        "title": "Start Learning Session",
        "category": "Sustain"
      },
      {
        "command": "sustain.checkSetup",
        "title": "Check Setup",
        "category": "Sustain",
        "icon": "$(checklist)"
      },
      {
        "command": "sustain.refreshHome",
        "title": "Refresh",
        "category": "Sustain",
        "icon": "$(refresh)"
      },
      {
        "command": "sustain.cancelRun",
        "title": "Cancel Run",
        "category": "Sustain",
        "icon": "$(debug-stop)"
      },
      {
        "command": "sustain.showInMap",
        "title": "Show in Map",
        "category": "Sustain",
        "icon": {
          "light": "media/sustain-light.svg",
          "dark": "media/sustain-dark.svg"
        }
      },
      {
        "command": "sustain.showFileInMap",
        "title": "Show in Architecture Map",
        "category": "Sustain"
      },
      {
        "command": "sustain.mapFolder",
        "title": "Map This Folder with Sustain",
        "category": "Sustain"
      },
      {
        "command": "sustain.openBoxCode",
        "title": "Open Code",
        "category": "Sustain"
      },
      {
        "command": "sustain.showChanges",
        "title": "Show Changes on Diagram",
        "category": "Sustain",
        "icon": "$(git-compare)"
      },
      {
        "command": "sustain.refreshArchitecture",
        "title": "Refresh Architecture",
        "category": "Sustain",
        "icon": "$(refresh)"
      },
      {
        "command": "sustain.refreshBox",
        "title": "Refresh This Box",
        "category": "Sustain"
      },
      {
        "command": "sustain.flagBox",
        "title": "This Box Is Wrong…",
        "category": "Sustain"
      },
      {
        "command": "sustain.exportPage",
        "title": "Export Page",
        "category": "Sustain",
        "icon": "$(globe)"
      },
      {
        "command": "sustain.auditMap",
        "title": "Audit Map",
        "category": "Sustain",
        "icon": "$(checklist)"
      },
      {
        "command": "sustain.hideChecks",
        "title": "Hide Checks",
        "category": "Sustain",
        "icon": "$(eye)"
      },
      {
        "command": "sustain.showChecks",
        "title": "Show Checks",
        "category": "Sustain",
        "icon": "$(eye-closed)"
      },
      {
        "command": "sustain.reviewChanges",
        "title": "Review Changes",
        "category": "Sustain"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sustain",
          "title": "Sustain",
          "icon": "media/sustain.svg"
        }
      ]
    },
    "views": {
      "sustain": [
        {
          "type": "webview",
          "id": "sustain.home",
          "name": "Sustain"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sustain.refreshHome",
          "when": "view == sustain.home",
          "group": "navigation@1"
        },
        {
          "command": "sustain.checkSetup",
          "when": "view == sustain.home",
          "group": "navigation@2"
        },
        {
          "command": "sustain.cancelRun",
          "when": "view == sustain.home && sustain.running",
          "group": "navigation@0"
        },
        {
          "command": "sustain.openArchitectureFile",
          "when": "view == sustain.home",
          "group": "more@1"
        },
        {
          "command": "sustain.installSkills",
          "when": "view == sustain.home",
          "group": "more@2"
        }
      ],
      "commandPalette": [
        {
          "command": "sustain.cancelRun",
          "when": "sustain.running"
        },
        {
          "command": "sustain.showFileInMap",
          "when": "false"
        },
        {
          "command": "sustain.mapFolder",
          "when": "false"
        },
        {
          "command": "sustain.openBoxCode",
          "when": "false"
        },
        {
          "command": "sustain.refreshBox",
          "when": "false"
        },
        {
          "command": "sustain.flagBox",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "sustain.showInMap",
          "when": "resourceScheme == file",
          "group": "navigation@100"
        },
        {
          "command": "sustain.showChanges",
          "when": "activeWebviewPanelId == 'sustain.architecture'",
          "group": "navigation@2"
        },
        {
          "command": "sustain.refreshArchitecture",
          "when": "activeWebviewPanelId == 'sustain.architecture'",
          "group": "navigation@1"
        },
        {
          "command": "sustain.exportPage",
          "when": "activeWebviewPanelId == 'sustain.architecture'",
          "group": "navigation@3"
        },
        {
          "command": "sustain.auditMap",
          "when": "activeWebviewPanelId == 'sustain.architecture'",
          "group": "navigation@4"
        },
        {
          "command": "sustain.hideChecks",
          "when": "activeWebviewPanelId == 'sustain.architecture' && !sustain.checksHidden",
          "group": "navigation@5"
        },
        {
          "command": "sustain.showChecks",
          "when": "activeWebviewPanelId == 'sustain.architecture' && sustain.checksHidden",
          "group": "navigation@5"
        }
      ],
      "explorer/context": [
        {
          "command": "sustain.mapFolder",
          "when": "explorerResourceIsFolder",
          "group": "sustain@1"
        },
        {
          "command": "sustain.showFileInMap",
          "when": "!explorerResourceIsFolder",
          "group": "sustain@2"
        }
      ],
      "webview/context": [
        {
          "command": "sustain.openBoxCode",
          "when": "webviewId == 'sustain.architecture' && webviewSection == 'box'",
          "group": "navigation@1"
        },
        {
          "command": "sustain.refreshBox",
          "when": "webviewId == 'sustain.architecture' && webviewSection == 'box'",
          "group": "navigation@2"
        },
        {
          "command": "sustain.flagBox",
          "when": "webviewId == 'sustain.architecture' && webviewSection == 'box'",
          "group": "navigation@3"
        }
      ]
    }
  },
  "workspaces": [
    "cloud"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "action": "node esbuild.mjs --action",
    "build:release": "node scripts/release.mjs",
    "bench": "node esbuild.mjs --bench && node out/bench/bench.mjs",
    "bench:plan": "node esbuild.mjs --bench && node out/bench/plan.mjs",
    "bench:fit": "node esbuild.mjs --bench && node out/bench/fit.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:docs": "node scripts/check-docs.mjs",
    "notices": "node scripts/notices.mjs --write",
    "check:notices": "node scripts/notices.mjs --check",
    "check": "npm run typecheck && npm run test && npm run check:docs && npm run build && npm run check:notices",
    "test:e2e": "npm run build && node esbuild.mjs --e2e && node out/e2e/runTest.js",
    "vscode:prepublish": "node esbuild.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "elkjs": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "1.125.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.6",
    "mocha": "12.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
